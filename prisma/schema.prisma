generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String?
  name      String?
  createdAt DateTime  @default(now())

  sessions  Session[]
  keys      Key[]

  bids      Bid[]
  jobs      Job[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Key {
  id             String   @id
  userId         String
  hashedPassword String?

  user           User     @relation(fields: [userId], references: [id])

  @@unique([id, userId])
}

model Job {
  id          String   @id @default(uuid())
  title       String
  description String
  budget      Int
  createdAt   DateTime @default(now())
  userId      String

  user        User     @relation(fields: [userId], references: [id])
  bids        Bid[]
}

model Bid {
  id        String   @id @default(uuid())
  amount    Int
  message   String
  createdAt DateTime @default(now())

  jobId     String
  userId    String

  job       Job      @relation(fields: [jobId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}
