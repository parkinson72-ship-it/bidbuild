generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())

  messagesSent     Message[] @relation("SentMessages")
  messagesReceived Message[] @relation("ReceivedMessages")

  jobs      Job[]
  sessions  Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())   // ← THIS LINE FIXES YOUR WARNING
}

model Job {
  id          String    @id @default(cuid())
  title       String
  description String
  budget      Int
  location    String
  createdAt   DateTime  @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id])

  messages    Message[]
}

model Message {
  id          String   @id @default(cuid())

  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])

  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])

  recipientId String
  recipient   User     @relation("ReceivedMessages", fields: [recipientId], references: [id])

  content     String?
  fileUrl     String?
  fileName    String?
  fileType    String?

  createdAt   DateTime @default(now())
  readAt      DateTime?

  clientId    String?  @unique
}
